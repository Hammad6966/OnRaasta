# Configuration names only. Never copy live credentials into source control.
NODE_ENV=development
HOST=0.0.0.0
PORT=5000
# Use one MongoDB URI name; the existing MONGO_URI remains supported.
MONGODB_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=
AI_SERVICE_URL=http://127.0.0.1:8000
AI_RECOMMEND_TIMEOUT_MS=2000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set true ONLY for read-only infrastructure diagnosis: no schema initialization,
# sockets, or HTTP mutations; /ready deliberately reports not_ready.
INFRA_READ_ONLY=false
# Optional integration tests: an explicitly isolated disposable replica-set server.
ONRAASTA_TEST_MONGO_URI=
# OTP provider configuration remains optional for controlled development tests.
DEV_OTP=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
